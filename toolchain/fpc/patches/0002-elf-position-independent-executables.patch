diff --git a/compiler/ogelf.pas b/compiler/ogelf.pas
index 8a885a5..b9482fc 100644
--- a/compiler/ogelf.pas
+++ b/compiler/ogelf.pas
@@ -310,7 +310,14 @@ interface
          procedure WriteDynTag(aTag:longword;aValue:longword);
