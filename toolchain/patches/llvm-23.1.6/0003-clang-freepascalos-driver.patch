+//===--- FreePascalOS.cpp - FreePascalOS ToolChain Implementation ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "FreePascalOS.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Driver.h"
+#include "clang/Options/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+using tools::addPathIfExists;
+
+// crt1.o for every program (position independent or not), crti.o and
+// crtbegin.o, crtbeginS.o or crtbeginT.o, as the GCC cross compiler picks
+// them.
+static void addStartFiles(const ToolChain &TC, const ArgList &Args,
+                          ArgStringList &CmdArgs, bool IsShared, bool IsStatic,
+                          bool IsPositionIndependent) {
+  if (!IsShared)
+    CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crt1.o")));
+  CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crti.o")));
+
+  std::string CrtBegin;
+  if (TC.GetRuntimeLibType(Args) == ToolChain::RLT_CompilerRT) {
+    std::string Path = TC.getCompilerRT(Args, "crtbegin", ToolChain::FT_Object);
+    if (TC.getVFS().exists(Path))
+      CrtBegin = Path;
+  }
+  if (CrtBegin.empty()) {
+    const char *Name = "crtbegin.o";
+    if (IsStatic)
+      Name = "crtbeginT.o";
+    else if (IsShared || IsPositionIndependent)
+      Name = "crtbeginS.o";
+    CrtBegin = TC.GetFilePath(Name);
+  }
+  CmdArgs.push_back(Args.MakeArgString(CrtBegin));
+  TC.addFastMathRuntimeIfAvailable(Args, CmdArgs);
+}
+
+static void addEndFiles(const ToolChain &TC, const ArgList &Args,
+                        ArgStringList &CmdArgs, bool IsShared, bool IsStatic,
+                        bool IsPositionIndependent) {
+  std::string CrtEnd;
+  if (TC.GetRuntimeLibType(Args) == ToolChain::RLT_CompilerRT) {
+    std::string Path = TC.getCompilerRT(Args, "crtend", ToolChain::FT_Object);
+    if (TC.getVFS().exists(Path))
+      CrtEnd = Path;
+  }
+  if (CrtEnd.empty()) {
+    const char *Name = "crtend.o";
+    if (!IsStatic && (IsShared || IsPositionIndependent))
+      Name = "crtendS.o";
+    CrtEnd = TC.GetFilePath(Name);
+  }
+  CmdArgs.push_back(Args.MakeArgString(CrtEnd));
+  CmdArgs.push_back(Args.MakeArgString(TC.GetFilePath("crtn.o")));
+}
+
+void tools::freepascalos::Linker::ConstructJob(Compilation &C,
+                                               const JobAction &JA,
+                                               const InputInfo &Output,
+                                               const InputInfoList &Inputs,
+                                               const ArgList &Args,
+                                               const char *LinkingOutput) const {
+  const auto &TC = static_cast<const Generic_ELF &>(getToolChain());
+  const Driver &D = TC.getDriver();
+  const bool IsRelocatable = Args.hasArg(options::OPT_r);
+  const bool IsShared = Args.hasArg(options::OPT_shared);
+  const bool IsStaticPIE = Args.hasArg(options::OPT_static_pie);
+  const bool IsStatic = Args.hasArg(options::OPT_static) && !IsStaticPIE;
+  bool IsPIE = false;
+  ArgStringList CmdArgs;
+
+  // Silence warnings for "clang -g foo.o -o foo" and the like.
+  Args.ClaimAllArgs(options::OPT_g_Group);
+  Args.ClaimAllArgs(options::OPT_emit_llvm);
+  Args.ClaimAllArgs(options::OPT_w);
+
+  if (!D.SysRoot.empty())
+    CmdArgs.push_back(Args.MakeArgString("--sysroot=" + D.SysRoot));
+
+  if (const char *Emulation = getLDMOption(TC.getTriple(), Args)) {
+    CmdArgs.push_back("-m");
+    CmdArgs.push_back(Emulation);
+  }
+
+  // The kernel maps segments with 4 KiB pages on both architectures.
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("max-page-size=4096");
+  CmdArgs.push_back("--hash-style=both");
+
+  if (IsShared)
+    CmdArgs.push_back("-shared");
+  if (IsStaticPIE) {
+    CmdArgs.push_back("-static");
+    CmdArgs.push_back("-pie");
+    CmdArgs.push_back("--no-dynamic-linker");
+    CmdArgs.push_back("-z");
+    CmdArgs.push_back("text");
+  } else if (IsStatic) {
+    CmdArgs.push_back("-static");
+  } else if (!IsRelocatable) {
+    if (Args.hasArg(options::OPT_rdynamic))
+      CmdArgs.push_back("-export-dynamic");
+    if (!IsShared) {
+      IsPIE = Args.hasFlag(options::OPT_pie, options::OPT_no_pie,
+                           TC.isPIEDefault(Args));
+      if (IsPIE)
+        CmdArgs.push_back("-pie");
+      CmdArgs.push_back("-dynamic-linker");
+      CmdArgs.push_back(Args.MakeArgString(Twine(D.DyldPrefix) +
+                                           TC.getDynamicLinker(Args)));
+    }
+    CmdArgs.push_back("--eh-frame-hdr");
+  }
+
+  assert((Output.isFilename() || Output.isNothing()) && "Invalid output.");
+  if (Output.isFilename()) {
+    CmdArgs.push_back("-o");
+    CmdArgs.push_back(Output.getFilename());
+  }
+
+  const bool NoStandardLibraries =
+      Args.hasArg(options::OPT_nostdlib, options::OPT_r);
+  const bool LinkStartFiles =
+      !NoStandardLibraries && !Args.hasArg(options::OPT_nostartfiles);
+  const bool LinkDefaultLibraries =
+      !NoStandardLibraries && !Args.hasArg(options::OPT_nodefaultlibs);
+  const bool PositionIndependent = IsPIE || IsStaticPIE;
+
+  if (LinkStartFiles)
+    addStartFiles(TC, Args, CmdArgs, IsShared, IsStatic, PositionIndependent);
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_u});
+  TC.AddFilePathLibArgs(Args, CmdArgs);
+
+  if (auto LTO = TC.getLTOMode(Args); LTO != LTOK_None)
+    addLTOOptions(TC, Args, CmdArgs, Output, Inputs, LTO == LTOK_Thin);
+
+  Args.addAllArgs(CmdArgs, {options::OPT_s, options::OPT_t});
+  addLinkerCompressDebugSectionsOption(TC, Args, CmdArgs);
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  if (LinkDefaultLibraries && D.CCCIsCXX()) {
+    if (TC.ShouldLinkCXXStdlib(Args)) {
+      bool OnlyStdlibStatic = Args.hasArg(options::OPT_static_libstdcxx) &&
+                              !Args.hasArg(options::OPT_static);
+      if (OnlyStdlibStatic)
+        CmdArgs.push_back("-Bstatic");
+      TC.AddCXXStdlibLibArgs(Args, CmdArgs);
+      if (OnlyStdlibStatic)
+        CmdArgs.push_back("-Bdynamic");
+    }
+    CmdArgs.push_back("-lm");
+  }
+  // Silence warnings when linking C code with a C++ '-stdlib' argument.
+  Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+
+  if (LinkDefaultLibraries) {
+    if (IsStatic || IsStaticPIE)
+      CmdArgs.push_back("--start-group");
+    AddRunTimeLibs(TC, D, CmdArgs, Args);
+    if (Args.hasArg(options::OPT_pthread, options::OPT_pthreads))
+      CmdArgs.push_back("-lpthread");
+    if (!Args.hasArg(options::OPT_nolibc))
+      CmdArgs.push_back("-lc");
+    if (IsStatic || IsStaticPIE)
+      CmdArgs.push_back("--end-group");
+    else
+      AddRunTimeLibs(TC, D, CmdArgs, Args);
+  }
+
+  if (LinkStartFiles)
+    addEndFiles(TC, Args, CmdArgs, IsShared, IsStatic, PositionIndependent);
+
+  // Linker scripts come after the search paths, so that their INPUT() and
+  // GROUP() directives find the libraries.
+  Args.addAllArgs(CmdArgs, {options::OPT_T});
+
+  const char *Exec = Args.MakeArgString(TC.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+FreePascalOS::FreePascalOS(const Driver &D, const llvm::Triple &Triple,
+                           const ArgList &Args)
+    : Generic_ELF(D, Triple, Args) {
+  GCCInstallation.init(Triple, Args);
+  Multilibs = GCCInstallation.getMultilibs();
+  SelectedMultilibs.assign({GCCInstallation.getMultilib()});
+
+  // The cross binutils' ld (<prefix>/<triple>/bin) next to the GCC.
+  Generic_GCC::PushPPaths(getProgramPaths());
+
+  // The GCC installation (libgcc, crtbegin*.o, libstdc++), then the system
+  // root's /usr/lib (mlibc) and /lib.
+  const std::string SysRoot = computeSysRoot();
+  path_list &Paths = getFilePaths();
+  Generic_GCC::AddMultilibPaths(D, SysRoot, "lib", "", Paths);
+  addPathIfExists(D, concat(SysRoot, "/usr/lib"), Paths);
+  addPathIfExists(D, concat(SysRoot, "/lib"), Paths);
+}
+
+Tool *FreePascalOS::buildAssembler() const {
+  return new tools::gnutools::Assembler(*this);
+}
+
+Tool *FreePascalOS::buildLinker() const {
+  return new tools::freepascalos::Linker(*this);
+}
+
+void FreePascalOS::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                             ArgStringList &CC1Args) const {
+  const Driver &D = getDriver();
+  const std::string SysRoot = computeSysRoot();
+
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  if (!DriverArgs.hasArg(options::OPT_nostdlibinc))
+    addSystemInclude(DriverArgs, CC1Args, concat(SysRoot, "/usr/local/include"));
+
+  // Clang's own headers (stddef.h, stdarg.h, the intrinsics), in the place
+  // of GCC's private include directory.
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> ResourceDirInclude(D.ResourceDir);
+    llvm::sys::path::append(ResourceDirInclude, "include");
+    addSystemInclude(DriverArgs, CC1Args, ResourceDirInclude);
+  }
+
+  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+    return;
+
+  addExternCSystemInclude(DriverArgs, CC1Args, concat(SysRoot, "/usr/include"));
+}
+
+void FreePascalOS::addLibStdCxxIncludePaths(const ArgList &DriverArgs,
+                                            ArgStringList &CC1Args) const {
+  // libstdc++'s headers come with the GCC installation.
+  if (GCCInstallation.isValid())
+    addGCCLibStdCxxIncludePaths(DriverArgs, CC1Args);
+}
