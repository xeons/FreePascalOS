+// FreePascalOS Target (C library: mlibc)
+template <typename Target>
+class LLVM_LIBRARY_VISIBILITY FreePascalOSTargetInfo
+    : public OSTargetInfo<Target> {
+protected:
+  void getOSDefines(const LangOptions &Opts, const llvm::Triple &Triple,
+                    MacroBuilder &Builder) const override {
+    DefineStd(Builder, "unix", Opts);
+    Builder.defineMacro("__freepascalos__");
+    if (Opts.POSIXThreads)
+      Builder.defineMacro("_REENTRANT");
+    // libstdc++ needs the GNU extensions of the C library, as with GCC.
+    if (Opts.CPlusPlus)
+      Builder.defineMacro("_GNU_SOURCE");
+    if (this->HasFloat128)
+      Builder.defineMacro("__FLOAT128__");
+  }
+
+public:
+  FreePascalOSTargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : OSTargetInfo<Target>(Triple, Opts) {
+    if (Triple.getArch() == llvm::Triple::x86_64)
+      this->HasFloat128 = true;
+  }
+};
