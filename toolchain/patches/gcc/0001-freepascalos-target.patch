diff -ruN a/gcc/config/freepascalos.h b/gcc/config/freepascalos.h
--- a/gcc/config/freepascalos.h	1969-12-31 18:00:00.000000000 -0600
+++ b/gcc/config/freepascalos.h	2026-11-24 18:47:35.191304351 -0600
@@ -0,0 +1,84 @@
+/* Definitions for FreePascalOS targets (x86_64-freepascalos and
+   aarch64-freepascalos), whose C library is mlibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Programs are position independent ELF files (PIE by default when
+   GCC is configured with --enable-default-pie). A dynamically linked
+   program names mlibc's dynamic linker as its interpreter; the kernel
+   maps the program and the interpreter and starts the interpreter,
+   which loads libc.so and the other libraries from /usr/lib. A static
+   program (-static) is an ordinary executable the kernel starts
+   directly.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()			\
+  do							\
+    {							\
+      builtin_define ("__freepascalos__");		\
+      builtin_define_std ("unix");			\
+      builtin_assert ("system=freepascalos");		\
+      builtin_assert ("system=unix");			\
+      builtin_assert ("system=posix");			\
+      /* libstdc++ needs the GNU extensions of the C	\
+	 library, as on GNU/Linux.  */			\
+      if (c_dialect_cxx ())				\
+	builtin_define ("_GNU_SOURCE");			\
+    }							\
+  while (0)
+
+#define FREEPASCALOS_DYNAMIC_LINKER "/usr/lib/ld.so"
+
+#undef  CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT}"
+
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{shared:;:crt1.o%s} crti.o%s " \
+  "%{static:crtbeginT.o%s;shared|static-pie|" PIE_SPEC ":crtbeginS.o%s;" \
+  ":crtbegin.o%s}"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC \
+  "%{Ofast|ffast-math|funsafe-math-optimizations:%{!shared:crtfastmath.o%s}} " \
+  "%{static:crtend.o%s;shared|static-pie|" PIE_SPEC ":crtendS.o%s;" \
+  ":crtend.o%s} crtn.o%s"
+
+#undef  LIB_SPEC
+#define LIB_SPEC "%{pthread:-lpthread} -lc"
+
+#undef  LINK_SPEC
+#define LINK_SPEC \
+  "-z max-page-size=4096 --hash-style=both " \
+  "%{shared:-shared} %{static:-static} %{rdynamic:-export-dynamic} " \
+  "%{!static:%{!static-pie:%{!shared:-dynamic-linker " \
+  FREEPASCALOS_DYNAMIC_LINKER "}}} " \
+  "%{static-pie:-static -pie --no-dynamic-linker -z text} " \
+  "%{!static:%{!static-pie:--eh-frame-hdr}}"
+
+/* Each object file says its stack need not be executable.  */
+#undef  TARGET_ASM_FILE_END
+#ifdef GCC_AARCH64_ELF_H
+#define TARGET_ASM_FILE_END aarch64_file_end_indicate_exec_stack
+#else
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+#endif
+
+/* mlibc provides the C99 and later math functions and sincos.  */
+#undef  TARGET_LIBC_HAS_FUNCTION
+#define TARGET_LIBC_HAS_FUNCTION gnu_libc_has_function
diff -ruN a/gcc/config.gcc b/gcc/config.gcc
--- a/gcc/config.gcc	2026-11-24 18:24:23.717265106 -0600
+++ b/gcc/config.gcc	2026-11-24 19:16:29.222274466 -0600
@@ -932,6 +932,19 @@
   rust_target_objs="${rust_target_objs} freebsd-rust.o"
   target_has_targetrustm=yes
   ;;
+*-*-freepascalos*)
+  # -pthread and -rdynamic, as on GNU systems.
+  extra_options="$extra_options gnu-user.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  use_gcc_stdint=wrap
+  native_system_header_dir=/usr/include
+  case ${enable_threads} in
+    "" | yes | posix) thread_file='posix' ;;
+  esac
+  tmake_file="${tmake_file} t-slibgcc"
+  ;;
 *-*-fuchsia*)
   native_system_header_dir=/include
   tmake_file="t-fuchsia"
@@ -1236,6 +1249,12 @@
 esac
 
 case ${target} in
+aarch64*-*-freepascalos*)
+	tm_file="${tm_file} elfos.h glibc-stdint.h"
+	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h freepascalos.h"
+	tmake_file="${tmake_file} aarch64/t-aarch64"
+	tm_defines="${tm_defines} TARGET_DEFAULT_ASYNC_UNWIND_TABLES=1"
+	;;
 aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h"
 	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h aarch64/aarch64-elf-raw.h"
@@ -2373,6 +2392,9 @@
 			;;
 	esac
 	;;
+x86_64-*-freepascalos*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h freepascalos.h"
+	;;
 x86_64-*-fuchsia*)
 	tmake_file="${tmake_file} i386/t-x86_64-elf"
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h fuchsia.h"
