+// No object may be larger than PTRDIFF_MAX, and the allocator's
+// rounding to pages would wrap for sizes near SIZE_MAX.
+static bool allocation_too_large(size_t size) {
+	return size > PTRDIFF_MAX;
+}
+
 void *malloc(size_t size) {
+	if (allocation_too_large(size)) {
+		errno = ENOMEM;
+		return nullptr;
+	}
