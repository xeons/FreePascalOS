license-files = /usr/share/licenses/spdx/AGPL-3.0-only.txt
license-marker = GNU AFFERO GENERAL PUBLIC LICENSE
name-marker = URW
files =
    /usr/share/fonts/gsfonts/NimbusSansNarrow-Regular.otf
    /usr/share/fonts/gsfonts/NimbusSansNarrow-Oblique.otf
