# The URW base 35 fonts (gsfonts): metric-compatible stand-ins for the
# PostScript core fonts (Nimbus Sans for Helvetica, Nimbus Roman for
# Times, Nimbus Mono PS for Courier, P052 for Palatino, C059 for New
# Century Schoolbook, URW Bookman, URW Gothic for Avant Garde, Z003 for
# Zapf Chancery, Standard Symbols PS, D050000L for Zapf Dingbats). The
# package has no licence file: its licence is AGPL 3.0 with URW's font
# exception (the upstream LICENSE note, kept in scripts/font-licenses,
# and the AGPL text from the host's SPDX licences).
[nimbus-sans]
name = Nimbus Sans
sets = full
package = gsfonts
upstream = https://github.com/ArtifexSoftware/urw-base35-fonts
license = AGPL-3.0-only WITH PS-or-PDF-font-exception-20170817
license-note = scripts/font-licenses/urw-base35-LICENSE
license-files = /usr/share/licenses/spdx/AGPL-3.0-only.txt
license-marker = GNU AFFERO GENERAL PUBLIC LICENSE
name-marker = URW
files =
    /usr/share/fonts/gsfonts/NimbusSans-Regular.otf
    /usr/share/fonts/gsfonts/NimbusSans-Italic.otf
    /usr/share/fonts/gsfonts/NimbusSans-Bold.otf
    /usr/share/fonts/gsfonts/NimbusSans-BoldItalic.otf

