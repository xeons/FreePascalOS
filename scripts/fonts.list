# The fonts the build copies from the host into /lib/fonts
# (scripts/collect-host-fonts.py), each family only if its licence
# lets it be passed on. Nothing here is kept in git: the files come from
# the build machine's font packages (Arch Linux paths; other machines
# skip what they lack, and the system works with the DejaVu fonts kept
# in userland/fonts).
#
# A section is a family, named by its directory in /lib/fonts:
#   name            the family's name (as documents ask for it)
#   sets            the font sets it is in: "full" (the system disk),
#                   "core" (the Raspberry Pi's RAM disk, served over
#                   TFTP, kept small)
#   package         the host package the files come from
#   upstream        where the fonts are made
#   license         the licence (SPDX)
#   license-files   the licence's full text: the first of these that
#                   exists (with license-note, a file in the source
#                   tree, put before it)
#   license-marker  text the licence file must contain
#   name-marker     text every font's own copyright or licence
#                   description (name table, IDs 0 and 13) must contain
#   files           the font files
#   core-files      the files the core set takes (default: all)
#
# Left out on purpose: the Indic fonts in /usr/share/fonts/TTF from
# ttf-indic-otf (mixed and unclear provenance), the Nerd Font patched
# fonts (their own licence is MIT/OFL, but the patched glyphs are not
# needed), Meslo, and Adwaita (OFL; not needed).

[liberation-sans]
name = Liberation Sans
sets = core full
package = ttf-liberation
upstream = https://github.com/liberationfonts/liberation-fonts
license = OFL-1.1
license-files = /usr/share/licenses/ttf-liberation/LICENSE
license-marker = SIL OPEN FONT LICENSE
name-marker = Open Font License
files =
    /usr/share/fonts/liberation/LiberationSans-Regular.ttf
    /usr/share/fonts/liberation/LiberationSans-Bold.ttf
    /usr/share/fonts/liberation/LiberationSans-Italic.ttf
    /usr/share/fonts/liberation/LiberationSans-BoldItalic.ttf
core-files =
    /usr/share/fonts/liberation/LiberationSans-Regular.ttf
    /usr/share/fonts/liberation/LiberationSans-Bold.ttf

[liberation-serif]
name = Liberation Serif
sets = core full
package = ttf-liberation
upstream = https://github.com/liberationfonts/liberation-fonts
license = OFL-1.1
license-files = /usr/share/licenses/ttf-liberation/LICENSE
license-marker = SIL OPEN FONT LICENSE
name-marker = Open Font License
files =
    /usr/share/fonts/liberation/LiberationSerif-Regular.ttf
    /usr/share/fonts/liberation/LiberationSerif-Bold.ttf
    /usr/share/fonts/liberation/LiberationSerif-Italic.ttf
    /usr/share/fonts/liberation/LiberationSerif-BoldItalic.ttf
core-files =
    /usr/share/fonts/liberation/LiberationSerif-Regular.ttf
    /usr/share/fonts/liberation/LiberationSerif-Bold.ttf

[liberation-mono]
name = Liberation Mono
sets = core full
package = ttf-liberation
upstream = https://github.com/liberationfonts/liberation-fonts
license = OFL-1.1
license-files = /usr/share/licenses/ttf-liberation/LICENSE
license-marker = SIL OPEN FONT LICENSE
name-marker = Open Font License
files =
    /usr/share/fonts/liberation/LiberationMono-Regular.ttf
    /usr/share/fonts/liberation/LiberationMono-Bold.ttf
    /usr/share/fonts/liberation/LiberationMono-Italic.ttf
    /usr/share/fonts/liberation/LiberationMono-BoldItalic.ttf
core-files =
    /usr/share/fonts/liberation/LiberationMono-Regular.ttf
    /usr/share/fonts/liberation/LiberationMono-Bold.ttf

# DejaVu: Sans and Sans Mono regular and bold are in userland/fonts;
# the host adds their obliques and DejaVu Serif.
[dejavu-sans]
name = DejaVu Sans
sets = full
package = ttf-dejavu
upstream = https://dejavu-fonts.github.io
license = Bitstream-Vera
license-files = /usr/share/licenses/ttf-dejavu/LICENSE
license-marker = Bitstream Vera Fonts Copyright
name-marker = Bitstream
files =
    /usr/share/fonts/TTF/DejaVuSans-Oblique.ttf
    /usr/share/fonts/TTF/DejaVuSans-BoldOblique.ttf

