{
  Cookie files in Netscape's format, as GNU wget and curl read and
  write them (--load-cookies, --save-cookies): a line per cookie of
  seven fields separated by tabs,

    domain  subdomains  path  secure  expiry  name  value

  with "TRUE" or "FALSE" for the flags; the domain has a leading dot
  when the cookie is for subdomains too, and an expiry of 0 marks a
  session cookie. Lines starting with "#" are comments, but for
  "#HttpOnly_" in front of the domain (an HttpOnly cookie). Expired
  cookies are skipped when read, and so are session cookies when
  written unless asked for (--keep-session-cookies).

  Plain Pascal (the RTL only), checked on the host by tools/WgetTest.
}
unit Http.CookieFiles;

{$mode objfpc}
{$H+}

interface

uses
  Http.Cookies;

{ Adds the cookies of a file's text to Jar; returns how many. }
function LoadCookieText(Jar: TCookieJar; const Text: string; Now: Int64): Integer;
{ The jar as a cookie file (the persistent cookies not yet expired, and
  the session ones too with KeepSessionCookies). }
function SaveCookieText(Jar: TCookieJar; KeepSessionCookies: Boolean; Now: Int64): string;

implementation

uses
  SysUtils;

const
  HttpOnlyPrefix = '#HttpOnly_';
  FileHeader = '# HTTP Cookie File'#10 +
    '# Generated by Wget on FreePascalOS.'#10 +
    '# Edit at your own risk.'#10#10;

function FlagText(Value: Boolean): string;
begin
  if Value then
    Result := 'TRUE'
  else
    Result := 'FALSE';
end;

{ One line into Cookie; False for comments and malformed lines. }
function ParseCookieLine(const Line: string; out Cookie: TCookie): Boolean;
var
  Text: string;
  Fields: TStringArray;
  Expiry: Int64;
begin
  Cookie := Default(TCookie);
  Result := False;
  Text := Line;
  if (Text <> '') and (Text[Length(Text)] = #13) then
    SetLength(Text, Length(Text) - 1);
  if Copy(Text, 1, Length(HttpOnlyPrefix)) = HttpOnlyPrefix then
  begin
    Cookie.HttpOnly := True;
    Delete(Text, 1, Length(HttpOnlyPrefix));
  end
  else if (Text = '') or (Text[1] = '#') then
    Exit;
  Fields := Text.Split([#9]);
  if Length(Fields) < 6 then
    Exit;
  if Length(Fields) = 6 then
  begin
    { An empty value at the end of the line. }
    SetLength(Fields, 7);
    Fields[6] := '';
  end;
  if not TryStrToInt64(Fields[4], Expiry) or (Fields[0] = '') or (Fields[5] = '') then
    Exit;
  Cookie.Domain := LowerCase(Fields[0]);
  Cookie.HostOnly := not SameText(Fields[1], 'TRUE');
  if Cookie.Domain[1] = '.' then
  begin
    Delete(Cookie.Domain, 1, 1);
    Cookie.HostOnly := False;
  end;
  Cookie.Path := Fields[2];
  if Cookie.Path = '' then
    Cookie.Path := '/';
  Cookie.Secure := SameText(Fields[3], 'TRUE');
  Cookie.Persistent := Expiry <> 0;
  Cookie.ExpiryTime := Expiry;
  Cookie.Name := Fields[5];
  Cookie.Value := Fields[6];
  Result := Cookie.Domain <> '';
end;

function LoadCookieText(Jar: TCookieJar; const Text: string; Now: Int64): Integer;
var
  Line: string;
  Cookie: TCookie;
begin
  Result := 0;
  for Line in Text.Split([#10]) do
  begin
    if not ParseCookieLine(Line, Cookie) then
      Continue;
    if Cookie.Persistent and (Cookie.ExpiryTime <= Now) then
      Continue;
    Jar.AddCookie(Cookie);
    Inc(Result);
  end;
end;

function CookieLine(constref Cookie: TCookie): string;
var
  Domain: string;
  Expiry: Int64;
begin
  Domain := Cookie.Domain;
  if not Cookie.HostOnly then
    Domain := '.' + Domain;
  if Cookie.HttpOnly then
    Domain := HttpOnlyPrefix + Domain;
  Expiry := 0;
  if Cookie.Persistent then
    Expiry := Cookie.ExpiryTime;
  Result := Domain + #9 + FlagText(not Cookie.HostOnly) + #9 + Cookie.Path + #9 + FlagText(Cookie.Secure) + #9 +
    IntToStr(Expiry) + #9 + Cookie.Name + #9 + Cookie.Value + #10;
end;

function SaveCookieText(Jar: TCookieJar; KeepSessionCookies: Boolean; Now: Int64): string;
var
  Index: Integer;
  Cookie: TCookie;
begin
  Result := FileHeader;
  for Index := 0 to Jar.Count - 1 do
  begin
    Cookie := Jar.Cookies[Index];
    if Cookie.Persistent and (Cookie.ExpiryTime <= Now) then
      Continue;
    if not Cookie.Persistent and not KeepSessionCookies then
      Continue;
    Result := Result + CookieLine(Cookie);
  end;
end;

end.
