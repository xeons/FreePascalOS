# Notepad: how the Start menu and the desktop show
# it (Configuration.ProgramInfo). Installed as /app/notepad/program.info.

[Program]
Name = Notepad
Description = Write and edit plain text files
Category = Accessories
Icon = app-text-editor
Executable = notepad
Keywords = ["text", "editor", "write"]
Version = 1.0
Extensions = ["txt", "text", "md", "markdown", "log", "ini", "conf", "cfg", "info", "json", "xml", "csv", "pas", "pp", "inc", "lpr", "c", "h", "cpp", "hpp", "py", "sh", "js", "css", "html", "htm", "svg", "yaml", "yml", "toml", "mk", "s", "asm"]
MimeTypes = ["text/*"]
