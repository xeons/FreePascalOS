  Key codes Paint's accelerators use beyond those of Controls.Keys (set
  1 scan codes, as input events carry them).
}
unit Paint.Keys;

{$mode objfpc}

interface

const
  KeyDigitZero = $0B;
  KeyMinus = $0C;
  KeyEquals = $0D;
  KeyE = $12;
  KeyI = $17;
  KeyW = $11;

implementation

end.
