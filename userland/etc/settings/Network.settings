# The network's configuration, applied by the network service
# (/bin/network), which applies changes to this file as soon as they
# are written. These defaults suit QEMU's user networking, whose DHCP
# server gives eth0 10.0.2.15/24, the gateway 10.0.2.2 and the DNS
# server 10.0.2.3.
#
# Per interface: Method "dhcp", "static" (Address = "A.B.C.D/N",
# Gateway = "A.B.C.D") or "none" (left alone); Up = false turns it off.
# An interface without a section is left alone.
# DnsServers: empty for those DHCP gives; a list overrides them.
# SearchDomain: empty for the domain DHCP gives.
DnsServers = []
SearchDomain = ""

[Interfaces/eth0]
Method = "dhcp"
Up = true
