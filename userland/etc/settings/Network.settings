# The network's configuration, applied by the network service
# (/bin/network), which applies changes to this file as soon as they
# are written. These defaults suit QEMU's user networking, whose DHCP
# server gives eth0 10.0.2.15/24, the gateway 10.0.2.2 and the DNS
# server 10.0.2.3.
#
# Per interface: Method "dhcp", "static" (Address = "A.B.C.D/N",
# Gateway = "A.B.C.D") or "none" (left alone); Up = false turns it off.
# Ipv6Method "auto" (from routers' advertisements), "static"
# (Ipv6Address = "fd00::10/64", Ipv6Gateway optional) or "none" (IPv6
# off); without one it is auto.
# An interface without a section is left alone (and IPv6 auto).
# DnsServers: empty for those DHCP (and IPv6 routers) give; a list of
# IPv4 or IPv6 addresses overrides them.
# SearchDomain: empty for the domain DHCP gives.
# DhcpStartWait: true waits 1-10 s at random before the first
# DHCPDISCOVER of a cold start (no lease kept from before), as RFC 2131
# 4.4.1 asks so that machines powered on together do not all ask at
# once; it is off here so the network is up as soon as the system is.
DnsServers = []
SearchDomain = ""
DhcpStartWait = false

[Interfaces/eth0]
Method = "dhcp"
Up = true
