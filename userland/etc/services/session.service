# The graphical session: the login window, then the user's desktop.
description   = Login and the desktop on the screen
program       = /bin/sessionmanager
needs         = displayserver
modes         = graphical
restart       = on-failure
restart-limit = 5
restart-delay = 2
# Stopping it logs the user off first: their programs have 8 seconds to
# end (and to ask about unsaved work) before they are ended.
stop-timeout  = 12
