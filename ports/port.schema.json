{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepascalos.invalid/ports/port.schema.json",
  "title": "FreePascalOS port (port.toml)",
  "description": "The format of ports/<category>/<name>/port.toml, read as TOML. scripts/ports.py lint checks every port against this file (type, required, properties, additionalProperties, enum, pattern, items, minItems, minimum). ports/README.md explains each key.",
  "type": "object",
  "required": ["port", "build"],
  "additionalProperties": false,
  "properties": {
    "port": {
      "type": "object",
      "required": ["name", "version", "summary", "description", "homepage", "license", "maintainer", "categories"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+._-]*$", "description": "The package name; lower case, no spaces."},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+~]*$", "description": "Upstream's version: no '-' or '_' (they separate the name and the revision)."},
        "revision": {"type": "integer", "minimum": 0, "description": "The port's own changes to the same version; back to 0 with a new version."},
        "summary": {"type": "string", "pattern": "^[^\\n]{1,79}$"},
        "description": {"type": "string"},
        "homepage": {"type": "string", "pattern": "^https?://"},
        "license": {"type": "string", "description": "An SPDX licence expression; every identifier must be on ports/licenses.txt."},
        "license_files": {"type": "array", "items": {"type": "string"}, "description": "Licence texts in the source tree (or port:files/...), installed as share/licenses/NAME/."},
        "maintainer": {"type": "string"},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "description": "The first is the folder the port is in."},
        "status": {"enum": ["tested", "untested", "broken"], "description": "untested: committed but never built and run on the system yet."},
        "architectures": {"type": "array", "minItems": 1, "items": {"enum": ["x86_64", "aarch64"]}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "sha256"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "pattern": "^(https?|ftp)://"},
          "mirrors": {"type": "array", "items": {"type": "string", "pattern": "^(https?|ftp)://"}},
          "filename": {"type": "string", "pattern": "^[^/]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "extract": {"type": "boolean"},
          "extract_dir": {"type": "string", "description": "The folder the archive unpacks into, relative to the work folder; the first source's is the source tree."},
          "signature": {
            "type": "object",
            "required": ["url", "type", "key"],
            "additionalProperties": false,
            "properties": {
              "url": {"type": "string", "pattern": "^(https?|ftp)://"},
              "type": {"enum": ["gpg", "ed25519"]},
              "key": {"type": "string", "description": "A keyring (gpg) or public key file (ed25519) in the port's folder."}
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {"type": "array", "items": {"type": "string"}, "description": "Ports whose packages are unpacked into the build's sysroot."},
        "run": {"type": "array", "items": {"type": "string"}, "description": "Packages that must be installed for this one to work (recorded in the package)."},
        "host": {"type": "array", "items": {"type": "string"}, "description": "Programs the build machine must have (looked up in PATH)."},
        "provides": {"type": "array", "items": {"type": "string"}, "description": "Other names this port answers to in dependencies."}
      }
    },
    "build": {
      "type": "object",
      "required": ["system"],
      "additionalProperties": false,
      "properties": {
        "system": {"enum": ["autotools", "meson", "cmake", "make", "fpc", "custom", "none"]},
        "toolchain": {"enum": ["c", "fpc", "none"], "description": "Defaults: c for autotools, meson, cmake and make; fpc for fpc; none otherwise."},
        "directory": {"type": "string", "description": "Where the build runs, relative to the source tree."},
        "out_of_tree": {"type": "boolean"},
        "parallel": {"type": "boolean"},
        "configure_script": {"type": "string"},
        "configure_args": {"type": "array", "items": {"type": "string"}},
        "make_args": {"type": "array", "items": {"type": "string"}},
        "install_args": {"type": "array", "items": {"type": "string"}},
        "install_target": {"type": "string"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "fpc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "programs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["source"],
                "additionalProperties": false,
                "properties": {
                  "source": {"type": "string"},
                  "name": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"}
                }
              }
            },
            "search_paths": {"type": "array", "items": {"type": "string"}},
            "include_paths": {"type": "array", "items": {"type": "string"}},
            "fpc_source_paths": {"type": "array", "items": {"type": "string"}, "description": "Folders of the Free Pascal source tree (FPC_SOURCE) to find units in, e.g. packages/fcl-base/src."},
            "libraries": {"type": "array", "items": {"type": "string"}, "description": "System libraries (lib<name>.so) to compile and link against, besides system, cryptography and coreutils."},
            "flags": {"type": "array", "items": {"type": "string"}},
            "defines": {"type": "array", "items": {"type": "string"}}
          }
        },
        "steps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre_configure": {"type": "array", "items": {"type": "string"}},
            "configure": {"type": "array", "items": {"type": "string"}},
            "build": {"type": "array", "items": {"type": "string"}},
            "install": {"type": "array", "items": {"type": "string"}},
            "post_install": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {"type": "string", "pattern": "^/"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "mode": {"type": "string", "pattern": "^0?[0-7]{3,4}$"}
            }
          }
        },
        "docs": {"type": "array", "items": {"type": "string"}},
        "remove": {"type": "array", "items": {"type": "string"}},
        "strip": {"type": "boolean"},
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre_install": {"type": "string"},
            "post_install": {"type": "string"},
            "pre_remove": {"type": "string"},
            "post_remove": {"type": "string"}
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "default"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string"},
          "default": {"type": "boolean"},
          "configure_on": {"type": "array", "items": {"type": "string"}},
          "configure_off": {"type": "array", "items": {"type": "string"}},
          "make_on": {"type": "array", "items": {"type": "string"}},
          "make_off": {"type": "array", "items": {"type": "string"}},
          "build_dependencies": {"type": "array", "items": {"type": "string"}},
          "run_dependencies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "flavors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {"type": "string"},
          "suffix": {"type": "string", "pattern": "^-[a-z0-9]+$"},
          "options": {"type": "object", "additionalProperties": {"type": "boolean"}}
        }
      }
    },
    "patches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strip": {"type": "integer", "minimum": 0},
        "order": {"type": "array", "items": {"type": "string"}}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {"type": "array", "items": {"type": "string"}, "description": "Run in the build folder on the build machine (only when not cross compiling, or always for fpc and none ports that test with host tools)."},
        "system": {"type": "array", "items": {"type": "string"}, "description": "Shell commands that check the installed package on the system; recorded in the package as test lines (pkg test NAME)."}
      }
    }
  }
}
