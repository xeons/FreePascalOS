@@ -2042,11 +2042,30 @@
 
 static char *GetDefaultConfigDir(void)
 {
+#ifdef __freepascalos__
+    // FreePascalOS: ~/.doom/ (made here, as M_MakeDirectory makes one
+    // folder), else the current folder.
+
+    char *home = getenv("HOME");
+
+    if (home != NULL && home[0] != '\0')
+    {
+        char *dir = M_StringJoin(home, DIR_SEPARATOR_S, ".doom", NULL);
+
+        M_MakeDirectory(dir);
+        free(dir);
+
+        return M_StringJoin(home, DIR_SEPARATOR_S, ".doom", DIR_SEPARATOR_S, NULL);
+    }
+
+    return strdup("./");
+#else
     char *result = (char *)malloc(2);
     result[0] = '.';
     result[1] = '\0';
 
     return result;
+#endif
 }
 
