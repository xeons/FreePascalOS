+#include <string.h>
+#include <freepascalos/windowing.h>
+
+#include "util/macros.h"
+#include "vk_util.h"
+#include "vk_instance.h"
+#include "vk_physical_device.h"
+#include "wsi_common_entrypoints.h"
+#include "wsi_common_private.h"
+
+typedef struct {
+   VkIcdSurfaceBase base;
+   struct fpos_window *window;
+} VkIcdSurfaceFreePascalOS;
+
+struct wsi_freepascalos {
+   struct wsi_interface base;
+};
+
+struct wsi_freepascalos_image {
+   struct wsi_image base;
+   bool busy;
+};
+
+struct wsi_freepascalos_swapchain {
+   struct wsi_swapchain base;
+   struct fpos_window *window;
+   VkExtent2D extent;
+   struct wsi_freepascalos_image images[0];
+};
+VK_DEFINE_NONDISP_HANDLE_CASTS(wsi_freepascalos_swapchain, base.base, VkSwapchainKHR,
+                               VK_OBJECT_TYPE_SWAPCHAIN_KHR)
+
+static const VkPresentModeKHR present_modes[] = {
+   VK_PRESENT_MODE_FIFO_KHR,
+   VK_PRESENT_MODE_MAILBOX_KHR,
+   VK_PRESENT_MODE_IMMEDIATE_KHR,
+};
+
+static const VkFormat surface_formats[] = {
+   VK_FORMAT_B8G8R8A8_UNORM,
+   VK_FORMAT_B8G8R8A8_SRGB,
+};
+
+static struct fpos_window *
+surface_window(VkIcdSurfaceBase *icd_surface)
+{
+   return ((VkIcdSurfaceFreePascalOS *)icd_surface)->window;
+}
+
+static VkResult
+fpos_surface_get_support(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                         uint32_t queueFamilyIndex, VkBool32 *pSupported)
+{
+   *pSupported = true;
+   return VK_SUCCESS;
+}
+
+static VkResult
+fpos_surface_get_capabilities2(VkIcdSurfaceBase *icd_surface,
+                               struct wsi_device *wsi_device,
+                               const void *info_next,
+                               VkSurfaceCapabilities2KHR *caps)
+{
+   struct fpos_window *window = surface_window(icd_surface);
+   VkSurfaceCapabilitiesKHR *base = &caps->surfaceCapabilities;
+   VkImageUsageFlags image_usage = wsi_caps_get_image_usage();
+   const VkSurfacePresentModeKHR *present_mode =
+      vk_find_struct_const(info_next, SURFACE_PRESENT_MODE_EXT);
+
+   base->minImageCount = 2;
+   base->maxImageCount = 0;
+   base->currentExtent = (VkExtent2D) { window->width, window->height };
+   base->minImageExtent = (VkExtent2D) { 1, 1 };
+   base->maxImageExtent = (VkExtent2D) {
+      wsi_device->maxImageDimension2D,
+      wsi_device->maxImageDimension2D,
+   };
+   base->maxImageArrayLayers = 1;
+   base->supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   base->currentTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+   base->supportedCompositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR |
+                                   VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR;
+   base->supportedUsageFlags = image_usage;
+
+   vk_foreach_struct(sType, ext, caps->pNext) {
+      switch (sType) {
+      case VK_STRUCTURE_TYPE_SURFACE_PROTECTED_CAPABILITIES_KHR: {
+         VkSurfaceProtectedCapabilitiesKHR *protected = (void *)ext;
+         protected->supportsProtected = VK_FALSE;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_KHR: {
+         VkSurfacePresentScalingCapabilitiesKHR *scaling = (void *)ext;
+         scaling->supportedPresentScaling = 0;
+         scaling->supportedPresentGravityX = 0;
+         scaling->supportedPresentGravityY = 0;
+         scaling->minScaledImageExtent = base->minImageExtent;
+         scaling->maxScaledImageExtent = base->maxImageExtent;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_COMPATIBILITY_KHR: {
+         VkSurfacePresentModeCompatibilityKHR *compat = (void *)ext;
+         if (compat->pPresentModes == NULL) {
+            compat->presentModeCount = 1;
+         } else if (compat->presentModeCount) {
+            compat->presentModeCount = 1;
+            compat->pPresentModes[0] =
+               present_mode ? present_mode->presentMode : VK_PRESENT_MODE_FIFO_KHR;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+fpos_surface_get_formats(VkIcdSurfaceBase *icd_surface, struct wsi_device *wsi_device,
+                         uint32_t *pSurfaceFormatCount, VkSurfaceFormatKHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(surface_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormatKHR, &out, format) {
+         format->format = surface_formats[i];
+         format->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+fpos_surface_get_formats2(VkIcdSurfaceBase *icd_surface, struct wsi_device *wsi_device,
+                          const void *info_next, uint32_t *pSurfaceFormatCount,
+                          VkSurfaceFormat2KHR *pSurfaceFormats)
+{
+   VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
+
+   for (unsigned i = 0; i < ARRAY_SIZE(surface_formats); i++) {
+      vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, format) {
+         format->surfaceFormat.format = surface_formats[i];
+         format->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+      }
+   }
+   return vk_outarray_status(&out);
+}
+
+static VkResult
+fpos_surface_get_present_modes(VkIcdSurfaceBase *surface, struct wsi_device *wsi_device,
+                               uint32_t *pPresentModeCount, VkPresentModeKHR *pPresentModes)
+{
+   if (pPresentModes == NULL) {
+      *pPresentModeCount = ARRAY_SIZE(present_modes);
+      return VK_SUCCESS;
+   }
+
+   *pPresentModeCount = MIN2(*pPresentModeCount, ARRAY_SIZE(present_modes));
+   typed_memcpy(pPresentModes, present_modes, *pPresentModeCount);
+   return *pPresentModeCount < ARRAY_SIZE(present_modes) ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+static VkResult
+fpos_surface_get_present_rectangles(VkIcdSurfaceBase *icd_surface,
+                                    struct wsi_device *wsi_device,
+                                    uint32_t *pRectCount, VkRect2D *pRects)
+{
+   struct fpos_window *window = surface_window(icd_surface);
+   VK_OUTARRAY_MAKE_TYPED(VkRect2D, out, pRects, pRectCount);
+
+   vk_outarray_append_typed(VkRect2D, &out, rect) {
+      *rect = (VkRect2D) {
+         .offset = { 0, 0 },
+         .extent = { window->width, window->height },
+      };
+   }
+   return vk_outarray_status(&out);
+}
+
+static struct wsi_image *
+fpos_swapchain_get_wsi_image(struct wsi_swapchain *wsi_chain, uint32_t image_index)
+{
+   struct wsi_freepascalos_swapchain *chain = (struct wsi_freepascalos_swapchain *)wsi_chain;
+   return &chain->images[image_index].base;
+}
+
+static VkResult
+fpos_swapchain_release_images(struct wsi_swapchain *wsi_chain, uint32_t count,
+                              const uint32_t *indices)
+{
+   struct wsi_freepascalos_swapchain *chain = (struct wsi_freepascalos_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < count; i++)
+      chain->images[indices[i]].busy = false;
+   return VK_SUCCESS;
+}
+
+static VkResult
+fpos_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
+                                  const VkAcquireNextImageInfoKHR *info,
+                                  uint32_t *image_index)
+{
+   struct wsi_freepascalos_swapchain *chain = (struct wsi_freepascalos_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (!chain->images[i].busy) {
+         chain->images[i].busy = true;
+         *image_index = i;
+         if (chain->window->width != (int32_t)chain->extent.width ||
+             chain->window->height != (int32_t)chain->extent.height)
+            return VK_SUBOPTIMAL_KHR;
+         return VK_SUCCESS;
+      }
+   }
+   return info->timeout == 0 ? VK_NOT_READY : VK_TIMEOUT;
+}
+
+static VkResult
+fpos_swapchain_queue_present(struct wsi_swapchain *wsi_chain, uint32_t image_index,
+                             uint64_t present_id, const VkPresentRegionKHR *damage)
+{
+   struct wsi_freepascalos_swapchain *chain = (struct wsi_freepascalos_swapchain *)wsi_chain;
+   struct wsi_freepascalos_image *image = &chain->images[image_index];
+   struct fpos_window *window = chain->window;
+   const uint8_t *source = image->base.cpu_map;
+   const uint32_t source_stride = image->base.row_pitches[0];
+   int32_t width = MIN2((int32_t)chain->extent.width, window->width);
+   int32_t height = MIN2((int32_t)chain->extent.height, window->height);
+
+   if (source && window->pixels && width > 0 && height > 0) {
+      for (int32_t row = 0; row < height; row++) {
+         memcpy(window->pixels + (size_t)row * window->width, source, (size_t)width * 4);
+         source += source_stride;
+      }
+      fpos_window_damage(window, 0, 0, width, height);
+   }
+   image->busy = false;
+
+   if (window->width != (int32_t)chain->extent.width ||
+       window->height != (int32_t)chain->extent.height)
+      return VK_SUBOPTIMAL_KHR;
+   return VK_SUCCESS;
+}
+
+static VkResult
+fpos_swapchain_wait_for_present(struct wsi_swapchain *wsi_chain, uint64_t waitValue,
+                                uint64_t timeout)
+{
+   return wsi_swapchain_wait_for_present_semaphore(wsi_chain, waitValue, timeout);
+}
+
+static VkResult
+fpos_swapchain_destroy(struct wsi_swapchain *wsi_chain, const VkAllocationCallbacks *pAllocator)
+{
+   struct wsi_freepascalos_swapchain *chain = (struct wsi_freepascalos_swapchain *)wsi_chain;
+
+   for (uint32_t i = 0; i < chain->base.image_count; i++) {
+      if (chain->images[i].base.image != VK_NULL_HANDLE)
+         wsi_destroy_image(&chain->base, &chain->images[i].base);
+   }
+   wsi_swapchain_finish(&chain->base);
+   vk_free(pAllocator, chain);
+   return VK_SUCCESS;
+}
+
+static VkResult
+fpos_surface_create_swapchain(VkIcdSurfaceBase *icd_surface, VkDevice device,
+                              struct wsi_device *wsi_device,
+                              const VkSwapchainCreateInfoKHR *pCreateInfo,
+                              const VkAllocationCallbacks *pAllocator,
+                              struct wsi_swapchain **swapchain_out)
+{
+   struct wsi_freepascalos_swapchain *chain;
+   struct wsi_cpu_image_params cpu_params = {
+      .base.image_type = WSI_IMAGE_TYPE_CPU,
+   };
+   uint32_t image_count = MAX2(pCreateInfo->minImageCount, 2);
+   uint32_t image = 0;
+   VkResult result;
+
+   if (!wsi_device->sw)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   chain = vk_zalloc(pAllocator, sizeof(*chain) + image_count * sizeof(chain->images[0]), 8,
+                     VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (chain == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   result = wsi_swapchain_init(wsi_device, &chain->base, device, pCreateInfo,
+                               &cpu_params.base, pAllocator);
+   if (result != VK_SUCCESS)
+      goto fail_free_chain;
+
+   chain->base.destroy = fpos_swapchain_destroy;
+   chain->base.get_wsi_image = fpos_swapchain_get_wsi_image;
+   chain->base.acquire_next_image = fpos_swapchain_acquire_next_image;
+   chain->base.release_images = fpos_swapchain_release_images;
+   chain->base.queue_present = fpos_swapchain_queue_present;
+   chain->base.wait_for_present = fpos_swapchain_wait_for_present;
+   chain->base.wait_for_present2 = fpos_swapchain_wait_for_present;
+   chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
+   chain->base.image_count = image_count;
+   chain->window = surface_window(icd_surface);
+   chain->extent = pCreateInfo->imageExtent;
+
+   for (; image < image_count; image++) {
+      result = wsi_create_image(&chain->base, &chain->base.image_info,
+                                &chain->images[image].base);
+      if (result != VK_SUCCESS)
+         goto fail_destroy_images;
+   }
+
+   *swapchain_out = &chain->base;
+   return VK_SUCCESS;
+
+fail_destroy_images:
+   for (uint32_t i = 0; i < image; i++)
+      wsi_destroy_image(&chain->base, &chain->images[i].base);
+   wsi_swapchain_finish(&chain->base);
+fail_free_chain:
+   vk_free(pAllocator, chain);
+   return result;
+}
+
+VkResult
+wsi_freepascalos_init_wsi(struct wsi_device *wsi_device, const VkAllocationCallbacks *alloc,
+                          VkPhysicalDevice physical_device)
+{
+   struct wsi_freepascalos *wsi =
+      vk_alloc(alloc, sizeof(*wsi), 8, VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+
+   if (!wsi) {
+      wsi_device->wsi[VK_ICD_WSI_PLATFORM_FREEPASCALOS] = NULL;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   memset(wsi, 0, sizeof(*wsi));
+   wsi->base.get_support = fpos_surface_get_support;
+   wsi->base.get_capabilities2 = fpos_surface_get_capabilities2;
+   wsi->base.get_formats = fpos_surface_get_formats;
+   wsi->base.get_formats2 = fpos_surface_get_formats2;
+   wsi->base.get_present_modes = fpos_surface_get_present_modes;
+   wsi->base.get_present_rectangles = fpos_surface_get_present_rectangles;
+   wsi->base.create_swapchain = fpos_surface_create_swapchain;
+
+   wsi_device->wsi[VK_ICD_WSI_PLATFORM_FREEPASCALOS] = &wsi->base;
+   return VK_SUCCESS;
+}
+
+void
+wsi_freepascalos_finish_wsi(struct wsi_device *wsi_device, const VkAllocationCallbacks *alloc)
+{
+   struct wsi_freepascalos *wsi =
+      (struct wsi_freepascalos *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_FREEPASCALOS];
+
+   if (wsi)
+      vk_free(alloc, wsi);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+wsi_CreateWindowSurfaceFPOS(VkInstance _instance,
+                            const VkWindowSurfaceCreateInfoFPOS *pCreateInfo,
+                            const VkAllocationCallbacks *pAllocator,
+                            VkSurfaceKHR *pSurface)
+{
+   VK_FROM_HANDLE(vk_instance, instance, _instance);
+   VkIcdSurfaceFreePascalOS *surface;
+
+   assert(pCreateInfo->sType == VK_STRUCTURE_TYPE_WINDOW_SURFACE_CREATE_INFO_FPOS);
+   if (pCreateInfo->window == NULL)
+      return VK_ERROR_INITIALIZATION_FAILED;
+
+   surface = vk_alloc2(&instance->alloc, pAllocator, sizeof *surface, 8,
+                       VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (surface == NULL)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   surface->base.platform = VK_ICD_WSI_PLATFORM_FREEPASCALOS;
+   surface->window = pCreateInfo->window;
+
+   *pSurface = VkIcdSurfaceBase_to_handle(&surface->base);
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkBool32 VKAPI_CALL
+wsi_GetPhysicalDeviceWindowPresentationSupportFPOS(VkPhysicalDevice physicalDevice,
+                                                   uint32_t queueFamilyIndex)
+{
+   return VK_TRUE;
+}
