+static struct fpos_window *
+fpos_surface_window(struct dri2_egl_surface *dri2_surf)
+{
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return NULL;
+   return dri2_surf->base.NativeSurface;
+}
+
+static void
+fpos_get_drawable_info(struct dri_drawable *draw, int *x, int *y, int *w,
+                       int *h, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+   struct fpos_window *window = fpos_surface_window(dri2_surf);
+
+   if (window) {
+      dri2_surf->base.Width = window->width;
+      dri2_surf->base.Height = window->height;
+   }
+   *x = 0;
+   *y = 0;
+   *w = dri2_surf->base.Width;
+   *h = dri2_surf->base.Height;
+}
+
+static void
+fpos_put_image2(struct dri_drawable *draw, int op, int x, int y, int w, int h,
+                int stride, char *data, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+   struct fpos_window *window = fpos_surface_window(dri2_surf);
+   const char *source = data;
+   int copy_width = w;
+   int row;
+
+   if (!window) {
+      swrast_pbuffer_loader_extension.putImage(draw, op, x, y, w, h, data,
+                                               loaderPrivate);
+      return;
+   }
+   if (!window->pixels || x < 0 || y < 0 || x >= window->width ||
+       y >= window->height)
+      return;
+   if (copy_width > window->width - x)
+      copy_width = window->width - x;
+   if (h > window->height - y)
+      h = window->height - y;
+
+   for (row = 0; row < h; row++) {
+      memcpy(window->pixels + (size_t)(y + row) * window->width + x, source,
+             (size_t)copy_width * 4);
+      source += stride;
+   }
+   fpos_window_damage(window, x, y, copy_width, h);
+}
+
+static void
+fpos_put_image(struct dri_drawable *draw, int op, int x, int y, int w, int h,
+               char *data, void *loaderPrivate)
+{
+   fpos_put_image2(draw, op, x, y, w, h, w * 4, data, loaderPrivate);
+}
+
+static void
+fpos_get_image2(struct dri_drawable *read, int x, int y, int w, int h,
+                int stride, char *data, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+   struct fpos_window *window = fpos_surface_window(dri2_surf);
+   char *target = data;
+   int copy_width = w;
+   int row;
+
+   if (!window) {
+      swrast_pbuffer_loader_extension.getImage(read, x, y, w, h, data,
+                                               loaderPrivate);
+      return;
+   }
+   memset(data, 0, (size_t)stride * h);
+   if (!window->pixels || x < 0 || y < 0 || x >= window->width ||
+       y >= window->height)
+      return;
+   if (copy_width > window->width - x)
+      copy_width = window->width - x;
+   if (h > window->height - y)
+      h = window->height - y;
+
+   for (row = 0; row < h; row++) {
+      memcpy(target, window->pixels + (size_t)(y + row) * window->width + x,
+             (size_t)copy_width * 4);
+      target += stride;
+   }
+}
+
+static void
+fpos_get_image(struct dri_drawable *read, int x, int y, int w, int h,
+               char *data, void *loaderPrivate)
+{
+   fpos_get_image2(read, x, y, w, h, w * 4, data, loaderPrivate);
+}
+
+static const __DRIswrastLoaderExtension fpos_swrast_loader_extension = {
+   .getDrawableInfo = fpos_get_drawable_info,
+   .putImage = fpos_put_image,
+   .getImage = fpos_get_image,
+   .putImage2 = fpos_put_image2,
+   .getImage2 = fpos_get_image2,
+};
+
+static const struct dri_loader_funcs fpos_loader_funcs = {
+   .image_lookup = &image_lookup_extension,
+   .swrast = &fpos_swrast_loader_extension,
+};
+
+static _EGLSurface *
+fpos_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
+                    void *native_surface, const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   struct dri2_egl_surface *dri2_surf;
+   const struct dri_config *config;
+
+   if (type == EGL_WINDOW_BIT && native_surface == NULL) {
+      _eglError(EGL_BAD_NATIVE_WINDOW, "fpos_create_surface");
+      return NULL;
+   }
+
+   dri2_surf = calloc(1, sizeof *dri2_surf);
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, "fpos_create_surface");
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, type, conf, attrib_list,
+                          false, native_surface))
+      goto cleanup_surface;
+
+   if (type == EGL_WINDOW_BIT) {
+      struct fpos_window *window = native_surface;
+      dri2_surf->base.Width = window->width;
+      dri2_surf->base.Height = window->height;
+   }
+
+   config = dri2_get_dri_config(dri2_conf, type, dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH,
+                "Unsupported surfacetype/colorspace configuration");
+      goto cleanup_surface;
+   }
+
+   if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf))
+      goto cleanup_surface;
+
+   return &dri2_surf->base;
+
+cleanup_surface:
+   free(dri2_surf);
+   return NULL;
+}
+
+static _EGLSurface *
+fpos_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                           void *native_window, const EGLint *attrib_list)
+{
+   return fpos_create_surface(disp, EGL_WINDOW_BIT, conf, native_window,
+                              attrib_list);
+}
+
+static _EGLSurface *
+fpos_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                            const EGLint *attrib_list)
+{
+   return fpos_create_surface(disp, EGL_PBUFFER_BIT, conf, NULL, attrib_list);
+}
+
+static EGLBoolean
+fpos_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   driDestroyDrawable(dri2_surf->dri_drawable);
+   free(dri2_surf->swrast_device_buffer);
+   dri2_surf->swrast_device_buffer = NULL;
+   dri2_fini_surface(surf);
+   free(dri2_surf);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+fpos_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw, const EGLint *rects,
+                  EGLint numRects)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   driSwapBuffers(dri2_surf->dri_drawable, numRects, rects);
+   return EGL_TRUE;
+}
+
+static EGLint
+fpos_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   return driSWRastQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static EGLBoolean
+fpos_swap_interval(_EGLDisplay *disp, _EGLSurface *surf, EGLint interval)
+{
+   return EGL_TRUE;
+}
+
+static const struct dri2_egl_display_vtbl fpos_display_vtbl = {
+   .create_window_surface = fpos_create_window_surface,
+   .create_pbuffer_surface = fpos_create_pbuffer_surface,
+   .destroy_surface = fpos_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_buffers = fpos_swap_buffers,
+   .swap_interval = fpos_swap_interval,
+   .query_buffer_age = fpos_query_buffer_age,
+};
+
+static bool
+fpos_is_window_format(enum pipe_format format)
+{
+   return format == PIPE_FORMAT_BGRA8888_UNORM ||
+          format == PIPE_FORMAT_BGRX8888_UNORM ||
+          format == PIPE_FORMAT_BGRA8888_SRGB ||
+          format == PIPE_FORMAT_BGRX8888_SRGB;
+}
+
+static void
+fpos_add_configs(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const EGLint attributes[] = {EGL_NATIVE_VISUAL_ID, 0, EGL_NONE};
+
+   for (unsigned i = 0; dri2_dpy->driver_configs[i] != NULL; i++) {
+      const struct dri_config *config = dri2_dpy->driver_configs[i];
+      const struct gl_config *gl_config = (const struct gl_config *)config;
+
+      if (!fpos_is_window_format(gl_config->color_format))
+         continue;
+      dri2_add_config(disp, config,
+                      EGL_WINDOW_BIT | EGL_PBUFFER_BIT |
+                         EGL_SWAP_BEHAVIOR_PRESERVED_BIT,
+                      attributes);
+   }
+}
+
+EGLBoolean
+dri2_initialize_freepascalos(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const char *error;
+
+   dri2_dpy->driver_name = strdup("swrast");
+   if (!dri2_dpy->driver_name) {
+      error = "DRI2: out of memory";
+      goto cleanup;
+   }
+   dri2_detect_swrast_kopper(disp);
+   dri2_dpy->loader_funcs = &fpos_loader_funcs;
+
+   if (!dri2_create_screen(disp)) {
+      error = "DRI2: failed to create screen";
+      goto cleanup;
+   }
+   if (!dri2_setup_device(disp, EGL_TRUE)) {
+      error = "DRI2: failed to setup EGLDevice";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+   disp->Extensions.EXT_buffer_age = EGL_TRUE;
+   disp->Extensions.EXT_swap_buffers_with_damage = EGL_TRUE;
+   fpos_add_configs(disp);
+
+   dri2_dpy->vtbl = &fpos_display_vtbl;
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, error);
+}
