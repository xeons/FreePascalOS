+{ CheckOptions refuses a bare "-"; here it names standard input or
+  output, so what it says about "-" is left out. }
+Function TPToP.CheckOptionsAllowingDash : String;
+
+Var
+  Errors : TStringList;
+  I : Integer;
+
+begin
+  Result:='';
+  Errors:=TStringList.Create;
+  Try
+    Errors.Text:=CheckOptions('icglbhv','',True);
+    For I:=0 to Errors.Count-1 do
+      If (Errors[I]<>'') and (Copy(Errors[I],Length(Errors[I])-2,3)<>'"-"') then
+        begin
+        If Result<>'' then
+          Result:=Result+sLineBreak;
+        Result:=Result+Errors[I];
+        end;
+  Finally
+    Errors.Free;
+  end;
+end;
+
