+{ Copies all of Source to Dest; Source may be a pipe (no size, no seeking). }
+Procedure CopyAll(Source, Dest : TStream);
+
+Var
+  Buffer : Array[0..4095] of Byte;
+  Got : LongInt;
+
+begin
+  Repeat
+    Got:=Source.Read(Buffer,SizeOf(Buffer));
+    If Got>0 then
+      Dest.WriteBuffer(Buffer,Got);
+  Until Got<=0;
+end;
